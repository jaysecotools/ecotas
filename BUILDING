        : (() => {
            const a = assessments.slice().sort((x, y) => (y.assessedAt || "").localeCompare(x.assessedAt || ""))[0];
            return `<p>${h(a.assessedAt)} — ${h(a.assessor)} — rating: <strong>${h(a.rating)}</strong></p>`;
          })()}
    </section>
  `;
});
